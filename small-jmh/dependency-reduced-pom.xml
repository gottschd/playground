<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.gottschd</groupId>
  <artifactId>small-jmh</artifactId>
  <name>small-jmh</name>
  <version>1.0-SNAPSHOT</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>benchmarks</finalName>
              <transformers>
                <transformer>
                  <mainClass>org.openjdk.jmh.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-toolchains-plugin</artifactId>
        <version>${maven-toolchains-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>toolchain</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <toolchains>
            <jdk>
              <id>openjdk-21</id>
            </jdk>
          </toolchains>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <properties>
    <jmh.version>1.36</jmh.version>
    <jakarta.xml.bind-api.version>4.0.0</jakarta.xml.bind-api.version>
    <spring-jcl.version>6.0.7</spring-jcl.version>
    <bcprov-jdk18on.version>1.72</bcprov-jdk18on.version>
    <spring-security-crypto.version>6.0.2</spring-security-crypto.version>
    <scrypt.version>1.4.0</scrypt.version>
    <jmh-generator-annprocess.version>${jmh.version}</jmh-generator-annprocess.version>
    <jaxb-impl.version>4.0.1</jaxb-impl.version>
    <maven-toolchains-plugin.version>3.2.0</maven-toolchains-plugin.version>
    <jmh-core.version>${jmh.version}</jmh-core.version>
  </properties>
</project>
